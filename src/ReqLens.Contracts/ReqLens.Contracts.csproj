<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the API and the Blazor client so the wire contract is one type, not two that
       have to be kept in step by hand. No dependencies on purpose: this assembly is downloaded
       into the browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
